{
  "name": "parlament-at-mcp",
  "version": "0.5.0",
  "description": "MCP server for the Austrian Parliament (Nationalrat, Bundesrat): members, inquiries, plenary protocols, legislative items - via the official open data JSON interface",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "parlament-at-mcp": "dist/index.js",
    "parlament-at-mcp-http": "dist/http-cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "smoke:live": "node scripts/smoke-live.mjs",
    "start:http": "node dist/http-cli.js",
    "dev:http": "tsx src/http-cli.ts",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests *.md *.json *.ts",
    "format:check": "prettier --check src tests",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "mcpName": "io.github.bernhardbrugger/parlament-at-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernhardbrugger/parlament-at-mcp.git"
  },
  "homepage": "https://github.com/bernhardbrugger/parlament-at-mcp#readme",
  "bugs": {
    "url": "https://github.com/bernhardbrugger/parlament-at-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "austria",
    "parliament",
    "parlament",
    "nationalrat",
    "bundesrat",
    "open-data",
    "legislation"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ]
}
