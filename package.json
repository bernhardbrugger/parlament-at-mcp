{
  "name": "parlament-at-mcp",
  "version": "0.3.0",
  "description": "MCP server for the Austrian Parliament (Nationalrat, Bundesrat): members, inquiries, plenary protocols, legislative items - via the official open data JSON interface",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "parlament-at-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "smoke:live": "node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
